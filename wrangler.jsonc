{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "virtual:solid-ssr-handler",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "FROM": "no-reply@cossie.dev",
    "VITE_STORAGE_DOMAIN": "https://r2.cossie.dev",
    "BETTER_AUTH_URL": "https://cossie.dev",
    "VITE_APP_URL": "https://cossie.dev"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "portfolio",
    "database_id": "d26a85b0-d106-4ec8-8f09-6fd13cc558b0"
  }],
  "kv_namespaces": [{
    "binding": "KV",
    "id": "a3a9750243014cb993aa5d7002c7ef7e"
  }]
}